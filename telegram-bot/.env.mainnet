# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=

# Blockchain Configuration
Somnia_RPC_URL=https://somnia-dataseed1.somnia.org
Somnia_TESTNET_RPC_URL=https://data-seed-presomnia-1-s1.somnia.org:8545
NETWORK=mainnet

# Veritas Contract Addresses (Not deployed yet - will update later)
VERITAS_CORE_ADDRESS=0x0000000000000000000000000000000000000000
REPUTATION_NFT_ADDRESS=0x0000000000000000000000000000000000000000
SCORE_CALCULATOR_ADDRESS=0x0000000000000000000000000000000000000000

# DreamDEX Event Contracts Contract (Somnia Mainnet)
DREAMDEX_PREDICTION_ADDRESS=0xB52c5934113Af5c0Bb20eb3C72290C8215f755b9

# Polymarket API
POLYMARKET_API_URL=https://gamma-api.polymarket.com

# Database Configuration (Optional - commented out for now)
# DATABASE_URL=postgresql://user:password@localhost:5432/veritas_bot

# Alert Settings
ALERT_CHECK_INTERVAL=60000
PRICE_CHANGE_THRESHOLD=5
VOLUME_CHANGE_THRESHOLD=10

# Features
ENABLE_POLYMARKET=true
ENABLE_DREAMDEXSWAP=true
ENABLE_VERITASSCORE=false

# Admin User IDs (Replace with your Telegram user ID from @userinfobot)
ADMIN_USER_IDS=YOUR_USER_ID_HERE

# Logging
LOG_LEVEL=info
