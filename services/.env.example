# Supabase Configuration (copy from frontend/.env.local)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Network Configuration
NETWORK=testnet  # or mainnet

# Optional: Start indexing from specific block
# START_BLOCK=0

# Optional: RPC URLs (uses default if not specified)
# Somnia_RPC_URL=https://somnia-dataseed.somnia.org
# Somnia_TESTNET_RPC_URL=https://data-seed-presomnia-1-s1.somnia.org:8545
