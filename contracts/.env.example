# Somnia RPC URLs
STT_TESTNET_RPC=https://data-seed-presomnia-1-s1.somnia.org:8545/
STT_MAINNET_RPC=https://somnia-dataseed.somnia.org/

# Private Key for Deployment (DO NOT COMMIT YOUR REAL KEY)
PRIVATE_KEY=your_private_key_here

# SomniaScan API Key for Contract Verification
SomniaSCAN_API_KEY=your_somniascan_api_key_here

# Optional: Etherscan API Key (if deploying to Ethereum)
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# ============================================
# DEPLOYMENT CONFIGURATION
# ============================================

# Deployer address (derived from PRIVATE_KEY)
# This address will be the owner of all deployed contracts

# ============================================
# CONTRACT ADDRESSES (Set after deployment)
# ============================================

# Core Contracts
REPUTATION_NFT_ADDRESS=
SCORE_CALCULATOR_ADDRESS=
PLATFORM_REGISTRY_ADDRESS=
VERITAS_CORE_ADDRESS=

# Adapters
DREAMDEX_PREDICTION_ADAPTER_ADDRESS=

# External Contracts (already deployed)
DREAMDEX_PREDICTION_V2_TESTNET=0xB52c5934113Af5c0Bb20eb3C72290C8215f755b9
DREAMDEX_PREDICTION_V2_MAINNET=0xB52c5934113Af5c0Bb20eb3C72290C8215f755b9

# ============================================
# NOTES
# ============================================

# 1. NEVER commit your actual private key to git
# 2. Get SomniaScan API key from: https://somniascan.com/myapikey
# 3. Make sure deployer address has sufficient STT for gas
# 4. Testnet STT faucet: https://testnet.somnia.org/faucet-smart
# 5. After deployment, update contract addresses in this file

# ============================================
# DEPLOYMENT COMMANDS
# ============================================

# Deploy to STT Testnet:
# forge script script/Deploy.s.sol:Deploy --rpc-url $STT_TESTNET_RPC --broadcast --verify -vvvv

# Deploy to STT Mainnet (use with caution):
# forge script script/Deploy.s.sol:Deploy --rpc-url $STT_MAINNET_RPC --broadcast --verify -vvvv

# Verify contracts manually (if auto-verify fails):
# forge verify-contract <CONTRACT_ADDRESS> <CONTRACT_PATH>:<CONTRACT_NAME> --chain-id 97 --etherscan-api-key $SomniaSCAN_API_KEY

# Example:
# forge verify-contract 0x123... src/core/VeritasCore.sol:VeritasCore --chain-id 97 --etherscan-api-key $SomniaSCAN_API_KEY
